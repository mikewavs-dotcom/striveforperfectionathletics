# PostgreSQL 15 connection string. SQLAlchemy + psycopg format.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/prospect_playground

# Anthropic API key used later for extraction and score rationales.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Contact email included in the crawler User-Agent string.
CONTACT_EMAIL=replace-with-contact-email

# Comma-separated US state codes to collect. Default VA. Add states here, not in code.
TARGET_STATES=VA

# ProPublica Nonprofit Explorer API v2 endpoints. Use {ein} in the organization URL.
PROPUBLICA_SEARCH_URL=https://projects.propublica.org/nonprofits/api/v2/search.json
PROPUBLICA_ORGANIZATION_URL=https://projects.propublica.org/nonprofits/api/v2/organizations/{ein}.json

# Policy monitor watchlist and stored content hashes. Paths are relative to the process cwd.
WATCHLIST_PATH=backend/watchlist.yaml
WATCHLIST_HASHES_PATH=backend/watchlist_hashes.json

# Staff directory pages. Paths are relative to the process cwd.
DIRECTORIES_PATH=backend/directories.yaml

# Google Places API (New). Search URL and grid are required for youth_orgs. Grid is
# south,west,north,east,step_degrees. Live calls are billed.
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
GOOGLE_PLACES_SEARCH_URL=https://places.googleapis.com/v1/places:searchText
GOOGLE_PLACES_GRID=36.54,-83.68,39.47,-75.24,1.5

# ReachInbox workspace API. Leave empty until you add the client's key. The app boots
# without it; Outreach APIs return 503 until a real key is set.
REACHINBOX_API_KEY=
REACHINBOX_BASE_URL=https://api.reachinbox.ai

# Apollo people search (Apollo finds people). Leave empty or use replace-with-…
# until a real key is set. GET /enrichment/status returns apollo=false until then.
APOLLO_API_KEY=

# Hunter email verifier (Hunter verifies emails). Leave empty or use replace-with-…
# until a real key is set. GET /enrichment/status returns hunter=false until then.
HUNTER_API_KEY=

# Frontend: copy API_URL into frontend/.env.local. Do not add it to this backend .env —
# backend settings reject unknown keys.
# API_URL=http://127.0.0.1:8000
